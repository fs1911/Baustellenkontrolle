# =============================================================================
# Baustellenkontrolle – Konfiguration
# Kopieren nach .env.local (Entwicklung). Niemals echte Secrets committen.
# Details: docs/deployment.md, docs/email-integration.md, docs/ai-integration.md
# =============================================================================

# Umgebung: development | test | staging | production (production erzwingt echte Provider)
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Datenbank (lokal: docker compose up -d; Supabase: Transaction Pooler, Port 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Authentifizierung: local (Entwicklung, Passwort gegen auth.users) | supabase (Produktion, inkl. MFA / Entra ID)
AUTH_PROVIDER=local
# Mindestens 32 zufällige Zeichen, z. B. `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string-with-at-least-32-chars
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Microsoft Entra ID (Azure) Login-Button anzeigen (Provider muss in Supabase konfiguriert sein)
AUTH_ENABLE_AZURE=false

# Speicher: local (Dateisystem .data/storage) | supabase (private Buckets)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
SIGNED_URL_TTL_SECONDS=300

# E-Mail: sandbox (.eml-Dateien, in der App einsehbar) | smtp | graph (Microsoft 365)
MAIL_PROVIDER=sandbox
MAIL_FROM_ADDRESS=baustellenkontrolle@example.ch
MAIL_SANDBOX_DIR=.data/mail-sandbox
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=

# KI: rules (lokal, Standard) | anthropic (zusätzlich Freigabe unter Einstellungen → KI nötig)
AI_PROVIDER=rules
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Bildverarbeitung: sharp (Node.js, Standard) | basic (Cloudflare Workers, ohne native Bibliothek)
IMAGE_PROCESSING=sharp

# Schutz für zeitgesteuerte Jobs (/api/jobs/*), Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Nur Seed: Passwort der Demo-Benutzer
DEMO_PASSWORD=Baustelle!2026
