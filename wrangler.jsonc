{
  // Cloudflare Workers (vinext). Anleitung: docs/deployment.md → «Cloudflare Workers».
  // Secrets NIE hier eintragen, sondern mit `npx wrangler secret put <NAME>`:
  //   DATABASE_URL (Supabase Session/Transaction Pooler), SESSION_SECRET, SUPABASE_SERVICE_ROLE_KEY
  // Datenbank bevorzugt über Hyperdrive: Binding "HYPERDRIVE" (siehe docs/deployment.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baustellenkontrolle",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // Datenbankverbindung über Hyperdrive (Supabase Session Pooler, Caching aus wegen RLS/Aktualität).
  // localConnectionString gilt nur für `wrangler dev` gegen die lokale Docker-DB.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ce0997021226419b8be88c64fe136737",
      "localConnectionString": "postgresql://postgres:postgres@localhost:54322/postgres"
    }
  ],
  "vars": {
    // Demo/Staging: lokale Anmeldung und Mail-Sandbox. Für Produktion siehe docs/deployment.md.
    "APP_ENV": "staging",
    "AUTH_PROVIDER": "local",
    "STORAGE_PROVIDER": "supabase",
    "NEXT_PUBLIC_SUPABASE_URL": "https://womwvpmnjlbrjuucbgkl.supabase.co",
    "MAIL_PROVIDER": "sandbox",
    "AI_PROVIDER": "rules",
    // Ohne native Bildbibliothek (sharp) – Fotos werden im Browser verkleinert.
    "IMAGE_PROCESSING": "basic",
    // Öffentliche Adresse des Workers (für sichere Cookies und CSRF-Prüfung).
    "APP_BASE_URL": "https://baustellenkontrolle.filip-subara.workers.dev",
  },
}
